<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 40" width="240" height="40">
  <!-- Visa -->
  <rect x="0" y="5" width="50" height="30" rx="4" fill="#1A1F71"/>
  <text x="25" y="25" font-family="Arial" font-size="14" font-weight="bold" fill="white" text-anchor="middle">VISA</text>
  <!-- Mastercard -->
  <rect x="60" y="5" width="50" height="30" rx="4" fill="#F0F0F0" stroke="#E0E0E0"/>
  <circle cx="79" cy="20" r="11" fill="#EB001B"/>
  <circle cx="91" cy="20" r="11" fill="#F79E1B"/>
  <path d="M85 12 A11 11 0 0 1 85 28 A11 11 0 0 1 85 12Z" fill="#FF5F00"/>
  <!-- COD -->
  <rect x="120" y="5" width="50" height="30" rx="4" fill="#4CAF50"/>
  <text x="145" y="25" font-family="Arial" font-size="11" font-weight="bold" fill="white" text-anchor="middle">COD</text>
  <!-- Bank -->
  <rect x="180" y="5" width="55" height="30" rx="4" fill="#2196F3"/>
  <text x="207" y="25" font-family="Arial" font-size="9" font-weight="bold" fill="white" text-anchor="middle">BANKING</text>
</svg>
